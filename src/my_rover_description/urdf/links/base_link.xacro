<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="base_link">

        <link name="base_link">

            <inertial>
                <origin
                    xyz="-0.013341170590699567 0.0 0.01"
                    rpy="0 0 0"/>

                <mass value="7.495180000000002"/>

                <inertia
                    ixx="0.08260502054366667"
                    ixy="4.5693013817071915e-17"
                    ixz="8.673617379884035e-19"
                    iyy="0.2689295125124481"
                    iyz="0.0"
                    izz="0.3510348543894482"/>
            </inertial>

            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <geometry>
                    <mesh
                        filename="package://my_rover_description/meshes/visual/base_link.stl"
                        scale="0.001 0.001 0.001"/>
                </geometry>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <geometry>
                    <mesh
                        filename="package://my_rover_description/meshes/visual/base_link.stl"
                        scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>

        </link>

    </xacro:macro>

</robot>
