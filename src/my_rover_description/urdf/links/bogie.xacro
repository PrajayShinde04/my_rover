<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="bogie" params="name parent xyz rpy">

    <link name="${name}">

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.7494588983667054"/>

        <inertia
          ixx="0.0027534717804587362"
          ixy="-7.962312379821606e-06"
          ixz="-1.09e-17"
          iyy="0.030789481894890357"
          iyz="2.49e-19"
          izz="0.03342632308212458"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <geometry>
          <mesh
            filename="package://my_rover_description/meshes/visual/bogie.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>

        <material name="gray">
  <color rgba="0.5 0.5 0.5 1.0"/>
</material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <geometry>
          <mesh
            filename="package://my_rover_description/meshes/visual/bogie.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

    </link>

    <joint name="${name}_joint" type="revolute">

      <origin xyz="${xyz}" rpy="${rpy}"/>

      <parent link="${parent}"/>
      <child link="${name}"/>

      <axis xyz="0 0 1"/>

      <limit
        lower="-0.610865"
        upper="0.523599"
        effort="1000"
        velocity="2.0"/>

      <dynamics
        damping="3.0"
        friction="0.5"/>

    </joint>

  </xacro:macro>

</robot>