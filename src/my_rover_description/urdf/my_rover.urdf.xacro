<?xml version="1.0"?>

<robot name="my_rover"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.6 0.4 0.1"/>
      </geometry>

      <material name="gray">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>

    </visual>

  </link>

</robot>