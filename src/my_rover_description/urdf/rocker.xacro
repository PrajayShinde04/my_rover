<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rocker" params="name parent xyz">

    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
  <mesh filename="package://my_rover_description/meshes/visual/rocker_link.stl"
        scale="0.001 0.001 0.001"/>
</geometry>
        <material name="blue">
          <color rgba="0.1 0.3 1.0 1.0"/>
        </material>
      </visual>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>