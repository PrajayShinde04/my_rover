<?xml version="1.0"?>

<robot name="my_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="world"/>

  <link name="base_link">

    <visual>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>

      <material name="gray">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>

    </visual>

  </link>

  <joint name="world_to_base" type="fixed">

    <parent link="world"/>

    <child link="base_link"/>

    <origin xyz="0 0 0" rpy="0 0 0"/>

  </joint>

</robot>